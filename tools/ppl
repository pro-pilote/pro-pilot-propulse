#!/usr/bin/env bash
# Lanceur unifié Pro-Pilot (macOS / Linux)
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ ! -d "$DIR/.pro-pilot" ] && [ -f "$DIR/bootstrap.py" ]; then
  echo "⚡ Premier lancement détecté : synchronisation du socle..."
  if command -v python3 >/dev/null 2>&1; then
    python3 "$DIR/bootstrap.py"
  elif command -v python >/dev/null 2>&1; then
    python "$DIR/bootstrap.py"
  fi
fi

PPL_SCRIPT="$DIR/.pro-pilot/tools/ppl.py"
if [ ! -f "$PPL_SCRIPT" ]; then
  if [ -f "$DIR/ppl.py" ]; then
    PPL_SCRIPT="$DIR/ppl.py"
  elif [ -f "$DIR/tools/ppl.py" ]; then
    PPL_SCRIPT="$DIR/tools/ppl.py"
  else
    echo "❌ Erreur : $PPL_SCRIPT introuvable. Exécutez : python3 bootstrap.py" >&2
    exit 1
  fi
fi

PY_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
  PY_BIN="python"
fi

if [ -f "$DIR/bootstrap.py" ]; then
  export PPL_WORKSPACE="${PPL_WORKSPACE:-$DIR}"
fi

exec "$PY_BIN" "$PPL_SCRIPT" "$@"
